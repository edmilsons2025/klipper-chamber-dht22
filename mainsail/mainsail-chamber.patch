index 0000000..54ffc06
--- /dev/null
+++ b/src/plugins/chamber.ts
@@ -0,0 +1,6 @@
+// Sensores da câmara (DHT22 lido pelo Orange Pi): temperature_sensor Chamber_* — ficam no painel Chamber
+export const isChamberSensor = (fullName: string): boolean => {
+    const name = fullName.indexOf(' ') !== -1 ? fullName.substring(fullName.indexOf(' ') + 1) : fullName
+    return fullName.startsWith('temperature_sensor ') && name.toLowerCase().startsWith('chamber_')
+}
+export const isHumiditySensor = (fullName: string): boolean => /humid/i.test(fullName)
