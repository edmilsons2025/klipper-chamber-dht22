diff --git a/src/components/panels/ChamberPanel.vue b/src/components/panels/ChamberPanel.vue
new file mode 100644
index 0000000..972e487
--- /dev/null
+++ b/src/components/panels/ChamberPanel.vue
@@ -0,0 +1,244 @@
+<template>
+    <panel
+        v-if="klipperReadyForGui && tempSensor"
+        :icon="mdiHomeThermometerOutline"
+        :title="$t('Panels.ChamberPanel.Headline')"
+        :collapsible="true"
+        card-class="chamber-panel">
+        <v-card-text class="pa-0">
+            <v-container class="py-2">
+                <v-row>
+                    <v-col v-for="item in items" :key="item.key" class="col-6 py-2">
+                        <div class="d-flex align-center">
+                            <v-icon :color="item.color" class="mr-3" large>{{ item.icon }}</v-icon>
+                            <div>
+                                <div class="text-caption text--secondary">{{ item.label }}</div>
+                                <div class="text-h5 font-weight-medium">{{ item.value }}</div>
+                                <div v-if="item.minMax" class="text-caption text--disabled">{{ item.minMax }}</div>
+                            </div>
+                        </div>
+                    </v-col>
+                </v-row>
+            </v-container>
+            <v-divider class="my-0" />
+            <e-chart
+                ref="chamberchart"
+                v-observe-visibility="visibilityChanged"
+                :option="chartOptions"
+                :init-options="{ renderer: 'svg' }"
+                :autoresize="true"
+                style="height: 200px; width: 100%"
+                @mouseenter.native="hoverChart = true"
+                @mouseleave.native="hoverChart = false" />
+        </v-card-text>
+    </panel>
+</template>
+
+<script lang="ts">
+import Component from 'vue-class-component'
+import { Mixins, Watch } from 'vue-property-decorator'
+import BaseMixin from '@/components/mixins/base'
+import ThemeMixin from '@/components/mixins/theme'
+import Panel from '@/components/ui/Panel.vue'
+import { mdiClock, mdiHomeThermometerOutline, mdiThermometer, mdiWater } from '@mdi/js'
+import { isChamberSensor, isHumiditySensor } from '@/plugins/chamber'
+import { PrinterTempHistoryStateSourceEntry } from '@/store/printer/tempHistory/types'
+import type { ECharts } from 'echarts/core'
+import type { ECBasicOption } from 'echarts/types/dist/shared.d'
+
+const COLOR_TEMP = '#AB47BC'
+const COLOR_HUMIDITY = '#26A69A'
+
+@Component({
+    components: { Panel },
+})
+export default class ChamberPanel extends Mixins(BaseMixin, ThemeMixin) {
+    declare $refs: {
+        chamberchart: any
+    }
+
+    mdiHomeThermometerOutline = mdiHomeThermometerOutline
+
+    hoverChart = false
+    isVisible = true
+
+    get chamberSensors(): string[] {
+        const sensors: string[] = this.$store.state.printer?.heaters?.available_sensors ?? []
+        return sensors.filter((name) => isChamberSensor(name))
+    }
+
+    get tempSensor(): string | null {
+        return this.chamberSensors.find((name) => !isHumiditySensor(name)) ?? null
+    }
+
+    get humiditySensor(): string | null {
+        return this.chamberSensors.find((name) => isHumiditySensor(name)) ?? null
+    }
+
+    sensorObject(name: string | null): any {
+        if (!name) return {}
+        return this.$store.state.printer[name] ?? {}
+    }
+
+    formatValue(value: number | null | undefined, unit: string): string {
+        if (value === null || value === undefined || isNaN(value)) return '--'
+        return `${value.toFixed(1)} ${unit}`
+    }
+
+    minMax(obj: any, unit: string): string | null {
+        const min = obj.measured_min_temp
+        const max = obj.measured_max_temp
+        if (typeof min !== 'number' || typeof max !== 'number' || min > max) return null
+        return `min ${min.toFixed(1)} ${unit} · max ${max.toFixed(1)} ${unit}`
+    }
+
+    get items() {
+        const temp = this.sensorObject(this.tempSensor)
+        const items = [
+            {
+                key: 'temperature',
+                label: this.$t('Panels.ChamberPanel.Temperature'),
+                icon: mdiThermometer,
+                color: COLOR_TEMP,
+                value: this.formatValue(temp.temperature, '°C'),
+                minMax: this.minMax(temp, '°C'),
+            },
+        ]
+        if (this.humiditySensor) {
+            const hum = this.sensorObject(this.humiditySensor)
+            items.push({
+                key: 'humidity',
+                label: this.$t('Panels.ChamberPanel.Humidity'),
+                icon: mdiWater,
+                color: COLOR_HUMIDITY,
+                value: this.formatValue(hum.temperature, '%'),
+                minMax: this.minMax(hum, '%'),
+            })
+        }
+        return items
+    }
+
+    get source(): PrinterTempHistoryStateSourceEntry[] {
+        return this.$store.state.printer.tempHistory.source ?? []
+    }
+
+    get timeFormat() {
+        return this.hours12Format ? '{hh}:{mm}' : '{HH}:{mm}'
+    }
+
+    get series() {
+        const series: any[] = []
+        if (this.tempSensor) {
+            series.push({
+                name: 'temperature',
+                type: 'line',
+                yAxisIndex: 0,
+                encode: { x: 'date', y: `${this.tempSensor}-temperature` },
+                showSymbol: false,
+                animation: false,
+                lineStyle: { color: COLOR_TEMP, width: 2 },
+                itemStyle: { color: COLOR_TEMP },
+            })
+        }
+        if (this.humiditySensor) {
+            series.push({
+                name: 'humidity',
+                type: 'line',
+                yAxisIndex: 1,
+                encode: { x: 'date', y: `${this.humiditySensor}-temperature` },
+                showSymbol: false,
+                animation: false,
+                lineStyle: { color: COLOR_HUMIDITY, width: 2 },
+                itemStyle: { color: COLOR_HUMIDITY },
+            })
+        }
+        return series
+    }
+
+    axis(name: string, color: string, align: string, extra: any) {
+        return {
+            name,
+            type: 'value',
+            nameLocation: 'end',
+            nameGap: 5,
+            nameTextStyle: { color, align },
+            splitLine: { lineStyle: { color: this.fgColorFaint } },
+            axisLabel: { color, margin: 5 },
+            axisLine: { show: true, lineStyle: { color: this.fgColorLow } },
+            ...extra,
+        }
+    }
+
+    get chartOptions(): ECBasicOption {
+        return {
+            renderer: 'svg',
+            animation: false,
+            grid: { top: 30, right: 40, bottom: 30, left: 40 },
+            tooltip: {
+                animation: false,
+                trigger: 'axis',
+                backgroundColor: this.bgColor(1),
+                borderWidth: 0,
+                textStyle: { color: this.fgColorHi, fontSize: '14px' },
+                padding: 12,
+                confine: true,
+                formatter: this.tooltipFormatter,
+            },
+            xAxis: {
+                type: 'time',
+                splitNumber: 5,
+                minInterval: 60 * 1000,
+                splitLine: { show: true, lineStyle: { color: this.fgColorFaint } },
+                axisLabel: { color: this.fgColorLow, margin: 10, formatter: this.timeFormat },
+            },
+            yAxis: [
+                this.axis('°C', COLOR_TEMP, 'left', {
+                    min: (v: any) => Math.floor(v.min - 2),
+                    max: (v: any) => Math.ceil(v.max + 2),
+                }),
+                this.axis('%', COLOR_HUMIDITY, 'right', { min: 0, max: 100, interval: 25, splitLine: { show: false } }),
+            ],
+            dataset: { source: [] },
+            series: this.series,
+        }
+    }
+
+    tooltipFormatter(datasets: any[]) {
+        if (!datasets.length) return ''
+        let time = datasets[0].axisValueLabel ?? ''
+        time = time.substring(time.indexOf(' '))
+        let output = `<div class="font-weight-bold pb-1"><svg viewBox="0 0 24 24" style="width:12px;height:12px;fill:currentColor;margin-right:5px"><path d="${mdiClock}"/></svg>${time}</div>`
+        datasets.forEach((d: any) => {
+            const key =
+                d.seriesName === 'humidity' ? `${this.humiditySensor}-temperature` : `${this.tempSensor}-temperature`
+            const value = d.value?.[key]
+            const unit = d.seriesName === 'humidity' ? '%' : '°C'
+            const label =
+                d.seriesName === 'humidity'
+                    ? this.$t('Panels.ChamberPanel.Humidity')
+                    : this.$t('Panels.ChamberPanel.Temperature')
+            output += `<div>${d.marker}${label}: <b>${typeof value === 'number' ? value.toFixed(1) : '--'} ${unit}</b></div>`
+        })
+        return output
+    }
+
+    get chart(): ECharts | null {
+        return this.$refs.chamberchart?.chart ?? null
+    }
+
+    visibilityChanged(isVisible: boolean) {
+        this.isVisible = isVisible
+    }
+
+    @Watch('source')
+    sourceChanged(newVal: PrinterTempHistoryStateSourceEntry[]) {
+        if (!this.chart || !this.isVisible || this.hoverChart) return
+        this.chart.setOption({ dataset: { source: newVal } })
+    }
+
+    beforeDestroy() {
+        if (typeof window === 'undefined') return
+        if (this.chart) this.chart.dispose()
+    }
+}
+</script>
